        /* --- PREMIUM GOLDEN THEME --- */
        :root {
            --gold: #ffd700;
            --gold-gradient: linear-gradient(135deg, #ffd700, #b8860b);
            --bg-dark: #000000;
            --card-bg: rgba(15, 15, 15, 0.98);
            --border-glow: 0 0 10px rgba(255, 215, 0, 0.4);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Arial', sans-serif; }
        body { background-color: var(--bg-dark); color: white; overflow-x: hidden; padding-bottom: 40px; }

        /* Header Banner */
        .banner { width: 100%; border-bottom: 3px solid var(--gold); box-shadow: 0 0 20px rgba(255, 215, 0, 0.5); }
        .banner img { width: 100%; display: block; }

        .container { padding: 15px; max-width: 800px; margin: auto; }

        /* Titles */
        .gold-title {
            text-align: center; color: var(--gold); font-size: 18px; font-weight: bold;
            margin: 30px 0 20px; text-transform: uppercase; letter-spacing: 2px;
            display: flex; align-items: center; justify-content: center; gap: 10px;
        }
        .gold-title::before, .gold-title::after { content: ""; width: 40px; height: 2px; background: var(--gold); }

        /* Features Grid (16 Buttons) */
        .features-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
        .feature-card {
            background: var(--card-bg); border: 1.5px solid var(--gold); border-radius: 12px;
            padding: 15px 5px; text-align: center; text-decoration: none; color: white;
            transition: 0.3s; display: flex; flex-direction: column; align-items: center; gap: 5px;
            box-shadow: inset 0 0 15px rgba(255, 215, 0, 0.1);
        }
        .feature-card:active { transform: scale(0.9); box-shadow: 0 0 15px var(--gold); }
        .feature-card i { font-size: 26px; color: var(--gold); text-shadow: 0 0 8px var(--gold); }
        .feature-card h4 { font-size: 9px; font-weight: bold; color: #fff; text-transform: uppercase; }
        .feature-card p { font-size: 7px; color: var(--gold); opacity: 0.9; }

        /* Video Gallery */
        .video-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .video-box { 
            background: #0a0a0a; border: 1.5px solid var(--gold); border-radius: 10px;
            overflow: hidden; box-shadow: 0 5px 15px rgba(0,0,0,0.5);
        }
        .video-box iframe { width: 100%; height: 110px; border: none; display: block; }
        .video-box p { font-size: 9px; padding: 6px; text-align: center; color: var(--gold); background: #111; }

        /* WhatsApp Section */
        .wa-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 20px; }
        .wa-card {
            background: linear-gradient(135deg, #00a859, #004d2c);
            border: 1.5px solid var(--gold); border-radius: 40px; padding: 10px;
            text-align: center; text-decoration: none; color: white;
            display: flex; flex-direction: column; align-items: center;
        }
        .wa-card i { font-size: 20px; margin-bottom: 2px; }
        .wa-card span { font-size: 10px; font-weight: bold; }

        /* Admin UI */
        .admin-btn { position: fixed; bottom: 20px; right: 20px; background: var(--gold); color: black; width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24px; cursor: pointer; z-index: 999; border: 2px solid white; box-shadow: 0 0 15px var(--gold); }
        #admin-panel { display: none; position: fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.95); z-index:1000; padding:20px; overflow-y: auto; }
        .login-box { max-width: 350px; margin: 80px auto; background: #111; padding: 30px; border: 2px solid var(--gold); border-radius: 20px; text-align: center; }
        input { width: 100%; padding: 12px; margin: 10px 0; background: #222; border: 1px solid var(--gold); color: white; border-radius: 10px; }
        .btn-update { width: 100%; padding: 12px; background: var(--gold-gradient); border: none; border-radius: 10px; font-weight: bold; cursor: pointer; color: #000; }

        /* Footer */
        .footer { text-align: center; margin-top: 40px; padding: 20px; border-top: 1px solid #333; }
        .footer h3 { color: var(--gold); font-size: 16px; margin-bottom: 5px; }
